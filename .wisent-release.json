{
  "schema_version": 1,
  "product": "wisent",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "wisent/__init__.py",
    "pattern": "(?m)^__version__\\s*=\\s*[\\\"'](?P<version>[0-9A-Za-z._-]+)[\\\"']"
  },
  "platforms": {
    "python": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "release-metadata",
          "argv": ["python3", "scripts/stado_release.py", "quality"]
        }
      ],
      "build": {
        "argv": ["python3", "scripts/stado_release.py", "build"]
      },
      "stage": {
        "release/python-distributions.tar": "release/python-distributions.tar"
      }
    }
  },
  "runtime": {
    "binary": "release/python-distributions.tar",
    "launcher": "release/python-distributions.tar",
    "config_schema": 1,
    "state_schema": 1,
    "minimum_stado_version": "0.1.0",
    "rollback_compatible_with": []
  },
  "promotion": {
    "channels": ["stable"],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": [
    {
      "name": "pypi",
      "platform": "python",
      "argv": ["python3", "scripts/stado_release.py", "deliver-pypi"],
      "required": true,
      "secret_env": {
        "PYPI_TOKEN": "PYPI_TOKEN#token"
      }
    }
  ]
}
