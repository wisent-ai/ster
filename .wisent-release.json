{
  "schema_version": 1,
  "product": "ster",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ],
          "kind": "format"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "stage": {
        "release/ster": "bin/ster",
        "release/ster-darwin-arm64.tar.gz": "release/ster-darwin-arm64.tar.gz",
        "release/ster-darwin-arm64.tar.gz.sha256": "release/ster-darwin-arm64.tar.gz.sha256"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ],
          "kind": "format"
        }
      ],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "stage": {
        "release/ster": "bin/ster",
        "release/ster-linux-amd64.tar.gz": "release/ster-linux-amd64.tar.gz",
        "release/ster-linux-amd64.tar.gz.sha256": "release/ster-linux-amd64.tar.gz.sha256"
      }
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/ster/dependencies/private-cargo-sources/sha256/7ff19fc7e13877d10491471b1c7271aca8fa82f504143817aeb5918e848dfc97/source.tar.gz",
      "sha256": "7ff19fc7e13877d10491471b1c7271aca8fa82f504143817aeb5918e848dfc97",
      "mount": "private-cargo-sources",
      "extract": true
    }
  },
  "deliveries": []
}
